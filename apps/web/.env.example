# Base URL of the MediQ REST API (apps/api), including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public address of the web app. Printed into every QR code (hospital page, doctor queue), so
# set it to the real domain in production. Leave empty in development to use the address the
# page is opened on.
NEXT_PUBLIC_SITE_URL=

# Google Maps JavaScript API key for the emergency finder map. Optional: without it the
# finder still works as a list with call and directions buttons. Restrict the key to your
# domain(s) and to the "Maps JavaScript API" in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Browser error tracking (Sentry). Optional: leave the DSN empty to switch it off. Use a
# separate Sentry project from the API's. No patient data is sent (see src/lib/sentry.ts).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
