# ---------------------------------------------------------------------------
# MediQ API environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Neon (neon.tech) -> project -> Connect.
# DATABASE_URL: the *pooled* string (host contains "-pooler"), used by the running API.
# DIRECT_URL:   the *direct* string (no "-pooler"), used by Prisma migrations/studio.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mediq?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/mediq?sslmode=require"
# Connections per API instance (Neon free tier allows plenty through the pooler).
DATABASE_POOL_MAX=10

# Secrets: generate each with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
OTP_HMAC_SECRET=change-me-to-another-long-random-string-of-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Refresh-token cookie. In production serve the API from a subdomain of the web
# app's domain (e.g. app.example.in + api.example.in), set COOKIE_SECURE=true and
# COOKIE_DOMAIN=.example.in.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Number of reverse proxies in front of the API (Render/AWS ALB = 1). 0 locally.
TRUST_PROXY=0

# SMS provider: mock (prints OTPs to the console; refused in production) | msg91 | twilio
SMS_PROVIDER=mock

BCRYPT_ROUNDS=12

# Current legal document versions; patients accept these at sign-up.
PRIVACY_POLICY_VERSION=2026-10-06
TERMS_VERSION=2026-10-01

# Used only by `pnpm db:seed` (development). Defaults are printed by the seed.
SEED_ADMIN_PASSWORD=

# File storage (doctor photos, slip templates): cloudinary.com -> Settings -> API Keys.
# Leave all three empty to disable uploads (they return 503 STORAGE_NOT_CONFIGURED).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder for this environment (mediq-dev / mediq-staging / mediq-prod).
STORAGE_FOLDER=mediq-dev

# Background jobs (slot generation). Set JOBS_ENABLED=false to run an API without jobs.
JOBS_ENABLED=true
SLOT_WINDOW_DAYS=30
SLOT_JOB_INTERVAL_HOURS=6

# Booking rules
BOOKING_HOLD_MINUTES=5
BOOKING_CLOSES_MINUTES_BEFORE=15
CHANGE_CLOSES_MINUTES_BEFORE=60
MAX_PENDING_HOLDS_PER_PATIENT=3
MAX_RESCHEDULES_PER_APPOINTMENT=2
HOLD_RELEASE_INTERVAL_SECONDS=30
# mock = development only ("Pay" confirms instantly). razorpay = real payments (Phase 4).
PAYMENT_MODE=mock

# ---------------------------------------------------------------------------
# Payments (Phase 4). Leave PAYMENT_MODE=mock until you have Razorpay *test* keys.
# 1. razorpay.com > Settings > API Keys > Generate test key
# 2. Settings > Webhooks > Add: URL https://YOUR-API/api/v1/webhooks/razorpay,
#    secret = RAZORPAY_WEBHOOK_SECRET below, events: payment.captured, payment.failed,
#    order.paid, refund.processed, refund.failed
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Free the held slot as soon as a payment attempt fails (a later success re-takes it or is refunded).
RELEASE_HOLD_ON_PAYMENT_FAILURE=true
REFUND_RETRY_MINUTES=10

# ---------------------------------------------------------------------------
# Notifications. SMS_PROVIDER (above): mock | msg91 | twilio
# ---------------------------------------------------------------------------
NOTIFICATION_CHANNEL=SMS
REMINDER_HOURS_BEFORE=2
NOTIFY_INTERVAL_SECONDS=15
# MSG91 (SMS): authkey + one DLT-approved flow template per message (texts are in the README)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP_LOGIN=
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_APPOINTMENT_REMINDER=
MSG91_TEMPLATE_APPOINTMENT_CANCELLED=
MSG91_TEMPLATE_APPOINTMENT_RESCHEDULED=
# Twilio (SMS and WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# --- Phase 6: monitoring, docs ---------------------------------------------
# Error tracking. Leave SENTRY_DSN empty to switch it off. Only unexpected server errors are
# sent, with request bodies, headers, cookies, query strings and personal details removed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# Optional: a release name (Render's RENDER_GIT_COMMIT is used if this is empty).
SENTRY_RELEASE=

# Interactive API reference at /api/docs. On by default in development, off in production.
# DOCS_ENABLED=true

# Testing only. Multiplies the per-IP rate limits. The API refuses to start in production unless this is 1.
# RATE_LIMIT_MULTIPLIER=1

# --- Phase 7: blood bank module ---------------------------------------------
# Waiting period between donations, in days. Women, and anyone who did not state a gender, wait the longer time.
DONOR_GAP_DAYS_MALE=90
DONOR_GAP_DAYS_OTHER=120
DONOR_MIN_AGE=18
DONOR_MAX_AGE=65
# A blood request closes by itself after this many hours; one phone can make this many per day.
BLOOD_REQUEST_TTL_HOURS=24
BLOOD_REQUESTS_PER_PHONE_PER_DAY=3
# Closed requests lose the requester name, number and note after this many days (kept that long to stop abuse).
BLOOD_REQUEST_RETENTION_DAYS=90
# Most donors one request alerts (nearest first) and most alerts one donor gets in a day.
BLOOD_MAX_DONORS_ALERTED=100
BLOOD_MAX_ALERTS_PER_DONOR_PER_DAY=2
# Stock figures older than this show as "call to confirm".
BLOOD_STOCK_STALE_HOURS=24
# MSG91 (DLT) template ids for the new messages. The exact texts to register are in the README.
# MSG91_TEMPLATE_OTP_VERIFY falls back to MSG91_TEMPLATE_OTP_LOGIN when empty.
MSG91_TEMPLATE_OTP_VERIFY=
MSG91_TEMPLATE_BLOOD_REQUEST_ALERT=
MSG91_TEMPLATE_BLOOD_REQUEST_BANK_ALERT=
MSG91_TEMPLATE_BLOOD_REQUEST_ANSWERED=
MSG91_TEMPLATE_DONATION_RECORDED=
MSG91_TEMPLATE_WAITLIST_SLOT_OPEN=

# --- Phase 8: reviews, waitlist, languages, subscriptions --------------------
# Patients can review a visit for this many days after it, and edit the review for this many.
REVIEW_WINDOW_DAYS=30
REVIEW_EDIT_DAYS=7
# Waitlist: active entries per patient, patients told per freed seat, how often the job looks (seconds).
WAITLIST_MAX_ACTIVE_PER_USER=5
WAITLIST_NOTIFY_BATCH=3
WAITLIST_INTERVAL_SECONDS=60
# Minutes a told patient holds their place before the next one in line is told.
WAITLIST_NOTICE_MINUTES=60
# Days after a paid period ends before a hospital stops taking online bookings.
SUBSCRIPTION_GRACE_DAYS=7
# The plan new hospitals start on (the free "pilot" plan exists after the migration).
DEFAULT_PLAN_CODE=pilot
# Hindi SMS for MSG91: JSON of template name to DLT template id. Messages without an entry go out in English.
# Example: MSG91_HINDI_TEMPLATE_IDS={"booking_confirmed":"abc123","appointment_reminder":"def456"}
MSG91_HINDI_TEMPLATE_IDS=
